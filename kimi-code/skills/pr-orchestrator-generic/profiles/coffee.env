# Shared loop profile: coffee / BrewedLate (pr-loop + scope-loop)
# REST queues only — no project board required for selection.
# Checkout: nz-coffee-hub → GitHub fstrauf/coffee
#
# Regenerate (optional, board-less):
#   pr-loop-setup coffee --repo-dir /Users/fstrauf/01_code/nz-coffee-hub --force
#
# Usage:
#   scope-loop --profile coffee --agent grok
#   pr-loop --profile coffee --agent grok
#   pr-loop --profile coffee --agent kimi
#
# Enqueue: gh issue edit N -R fstrauf/coffee --add-label ready
# (After scope-loop adds ready automatically when scoping succeeds.)

REPO=fstrauf/coffee
REPO_DIR=/Users/fstrauf/01_code/nz-coffee-hub

# 0 = agents do not update kanban. Selection is REST labels only.
ORCH_BOARD=0

# Land green PRs from the loop (set ORCH_AUTO_MERGE=0 to leave PRs for humans).
#
# Reality on this machine (2026-08): two deliberate local guards make the
# classic land path fail for coffee —
#   1. ~/.local/bin/gh shim blocks every `gh pr merge` ("requires human approval")
#   2. nz-coffee-hub .husky/pre-push rejects pushes to master without a green
#      .test-pipeline-passed.json stamp matching HEAD (push-land squash commit
#      has no stamp → push rejected)
# The loop therefore runs in stack-through mode: PRs chain onto unmerged
# dependency branches (ORCH_BASE_BRANCH), issues park as `awaiting-merge`,
# and you land a whole chain at once with:
#   gh stack merge <top-pr> --yes --squash      (native Stacks are enabled here)
# The next pr-loop run restacks whatever remains. To let the loop land chains
# itself (bypasses the gh shim — opt in consciously): ORCH_STACK_AUTOLAND=1.
ORCH_AUTO_MERGE=1
ORCH_MERGE_VIA_PUSH=1

# Ship gate (local CI). package.json test:gate → npm run test:all.
# Pre-push to master requires a green .test-pipeline-passed.json stamp.
# GitHub Actions only builds + deploys (no quality suite on GHA).

# Default skill: generic works on Grok + Kimi.
# Repo also has .kimi/skills/pr-orchestrator-coffee (npm ship gate) for Kimi:
#   ORCH_SKILL='/skill:pr-orchestrator-coffee' pr-loop --profile coffee --agent kimi
# Grok:
#   ORCH_SKILL=/pr-orchestrator-generic  (default)

# Model routing, kept simple (2026-10-14): scope on Opus, everything in the
# ship loop on Sonnet. A pinned role never escalates, so shipping never reaches
# Opus and never drops to Haiku. Remove a line to hand that role back to routing.py.
ORCH_ROUTE_SCOPE=strong:medium
ORCH_ROUTE_COORDINATE=mid:low
ORCH_ROUTE_IMPLEMENT=mid:medium
ORCH_ROUTE_REVIEW=mid:medium
ORCH_ROUTE_FIX=mid:low
ORCH_ROUTE_EXPLORE=mid:low
ORCH_ROUTE_TRIAGE=mid:low
