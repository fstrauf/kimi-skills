# Shared loop profile: call-analyzer (Days to Expiry / fiAnalyst)
# Used by: pr-loop (Ready) + scope-loop (Scoping)
#
# CRITICAL PRODUCT — never auto-land to main.
# REST queue only: label issues `ready` to enqueue.
# Board is human view only when ORCH_BOARD=0.

REPO=fstrauf/call-analyzer
REPO_DIR=/Users/fstrauf/01_code/call-analyzer

# 0 = agents do not update kanban (recommended). Selection is REST labels only.
ORCH_BOARD=0

# NEVER merge to main from the loop in this repo. Orchestrator opens/marks
# PRs ready; a human reviews and merges.
ORCH_AUTO_MERGE=0
ORCH_MERGE_VIA_PUSH=0
# Stack-aware land (mode A): auto = gh stack merge when PR is in an open chain.
# Irrelevant while ORCH_AUTO_MERGE=0; still used if you temporarily enable land.
# ORCH_STACK=auto

# Call-analyzer-specific Grok skill (real-user QA + monorepo test gate).
# Override at launch if you intentionally want the generic skill.
ORCH_SKILL=/pr-orchestrator
