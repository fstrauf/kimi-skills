# Shared loop profile: learnedlate (pr-loop + scope-loop)
# REST queues only — no project board required for selection.
#
# Created board-less because no GitHub Project exists for fstrauf/learnedlate.
# (setup-profile.sh auto-detect requires a board with issues; not needed for
# scope-loop / pr-loop when ORCH_BOARD=0.)
#
# Usage:
#   scope-loop --profile learnedlate --agent grok
#   scope-loop --profile learnedlate --agent grok 1   # one issue
#   pr-loop --profile learnedlate --agent grok
#
# Queue: open non-epic issues not labeled ready/agent-*/blocked/needs-input
# After scope success: +ready (unless blocked / needs-input)

REPO=fstrauf/learnedlate
REPO_DIR=/Users/fstrauf/01_code/learnedlate

# 0 = agents do not update kanban. Selection is REST labels only.
ORCH_BOARD=0

# Land green PRs from the loop (set ORCH_AUTO_MERGE=0 to leave PRs for humans).
ORCH_AUTO_MERGE=1
ORCH_MERGE_VIA_PUSH=1
